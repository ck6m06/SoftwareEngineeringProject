@startuml
title Use Case 5.3: Data Audit (Admin)
actor Admin
participant AdminDashboard.vue
participant animals.ts
participant admin.py
participant animal_service.py
participant notification_service.py
database MySQL

Admin -> AdminDashboard.vue: Visit /admin/dashboard
AdminDashboard.vue -> animals.ts: listAnimals(status=SUBMITTED)
animals.ts -> admin.py: GET /animals?status=SUBMITTED
admin.py -> animal_service.py: list_animals()
animal_service.py -> MySQL: SELECT animals WHERE status=SUBMITTED
MySQL --> animal_service.py: pending_animals[]
animal_service.py --> admin.py: result
admin.py --> animals.ts: 200 OK
animals.ts --> AdminDashboard.vue: pending_animals
AdminDashboard.vue --> Admin: Display pending list

alt Approve Animal
  Admin -> AdminDashboard.vue: Click Approve
  AdminDashboard.vue -> animals.ts: updateAnimalStatus(id, PUBLISHED)
  animals.ts -> admin.py: PATCH /animals/{id}
  admin.py -> animal_service.py: update_status()
  animal_service.py -> MySQL: UPDATE animals SET status=PUBLISHED
  MySQL --> animal_service.py: success
  animal_service.py -> notification_service.py: notify_owner(approved)
  notification_service.py -> MySQL: INSERT notification
  animal_service.py --> admin.py: animal
  admin.py --> animals.ts: 200 OK
  animals.ts --> AdminDashboard.vue: success
  AdminDashboard.vue --> Admin: Approved successfully
else Reject Animal
  Admin -> AdminDashboard.vue: Click Reject with reason
  AdminDashboard.vue -> animals.ts: updateAnimalStatus(id, DRAFT, reason)
  animals.ts -> admin.py: PATCH /animals/{id}
  admin.py -> animal_service.py: update_status()
  animal_service.py -> MySQL: UPDATE animals SET status=DRAFT
  animal_service.py -> notification_service.py: notify_owner(rejected)
  notification_service.py -> MySQL: INSERT notification
  animal_service.py --> admin.py: animal
  admin.py --> animals.ts: 200 OK
  animals.ts --> AdminDashboard.vue: success
  AdminDashboard.vue --> Admin: Rejected with feedback
end
@enduml