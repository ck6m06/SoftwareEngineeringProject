@startuml
title Use Case: Audit Logs View (Admin)
actor Admin
participant AuditLogs.vue
participant auditLogs.ts
participant admin.py
participant audit_service.py
database MySQL

Admin -> AuditLogs.vue: Visit /audit-logs
AuditLogs.vue -> auditLogs.ts: getAuditLogs(filters)
auditLogs.ts -> admin.py: GET /admin/audit-logs
admin.py -> admin.py: Verify admin role
admin.py -> audit_service.py: get_audit_logs()
audit_service.py -> MySQL: SELECT audit_logs WITH filters
MySQL --> audit_service.py: logs[]
audit_service.py --> admin.py: result
admin.py --> auditLogs.ts: 200 OK
auditLogs.ts --> AuditLogs.vue: logs
AuditLogs.vue --> Admin: Display audit logs

Admin -> AuditLogs.vue: Filter by user/action/date
AuditLogs.vue -> AuditLogs.vue: Update filter params
AuditLogs.vue -> auditLogs.ts: getAuditLogs(new_filters)
auditLogs.ts -> admin.py: GET /admin/audit-logs?filters
admin.py -> audit_service.py: get_audit_logs(filters)
audit_service.py -> MySQL: SELECT with WHERE clauses
MySQL --> audit_service.py: filtered_logs[]
audit_service.py --> admin.py: result
admin.py --> auditLogs.ts: 200 OK
auditLogs.ts --> AuditLogs.vue: filtered_logs
AuditLogs.vue --> Admin: Display filtered results
@enduml