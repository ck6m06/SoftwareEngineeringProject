# ========================================
# Frontend 開發與測試環境配置
# ========================================
# 用途: Frontend 開發與 E2E 測試配置
# 
# 📦 使用 Docker Compose? 
#    請參考: proj_new/.env.example (整合配置)
#
# ☁️ 部署到 GCP? 
#    請參考下方 GCP 配置範例
# ========================================

# Vite 環境變數
VITE_API_BASE_URL=http://localhost:5000/api

# E2E 測試環境配置
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ========================================
# GCP 部署環境範例
# ========================================

# App Engine 部署
# FRONTEND_URL=https://your-frontend-app.appspot.com
# BACKEND_URL=https://your-backend-api.appspot.com
# VITE_API_BASE_URL=https://your-backend-api.appspot.com/api

# Cloud Run 部署
# FRONTEND_URL=https://your-frontend-service-xyz.run.app
# BACKEND_URL=https://your-api-service-xyz.run.app
# VITE_API_BASE_URL=https://your-api-service-xyz.run.app/api

# 混合環境 (前端在 GCP，後端在本地開發)
# FRONTEND_URL=https://your-frontend-app.appspot.com
# BACKEND_URL=http://localhost:5000
# VITE_API_BASE_URL=http://localhost:5000/api
