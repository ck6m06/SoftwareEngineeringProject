# ========================================
# GCP 低成本部署配置範例
# ========================================
# 使用方式: 
# 1. 複製此檔案為 .env.gcp
# 2. 填入實際配置（使用容器內服務節省成本）
# 3. docker-compose --env-file .env.gcp -f docker-compose-gcp.yml up -d
#
# 成本優化: 所有服務運行在容器內，不使用 GCP 託管服務
# ========================================

# ========================================
# 資料庫配置 (容器內 MySQL)
# ========================================
MYSQL_ROOT_PASSWORD=your-strong-root-password-here
MYSQL_DATABASE=pet_adoption
MYSQL_USER=petuser
MYSQL_PASSWORD=your-strong-db-password-here

# ========================================
# Redis 配置 (容器內 Redis，無密碼)
# ========================================
# 無需配置，使用預設值

# ========================================
# MinIO 物件儲存配置 (容器內)
# ========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-strong-minio-password-here
# 替換為您的 VM IP 或域名
MINIO_SERVER_URL=http://YOUR_VM_IP:9000
MINIO_EXTERNAL_ENDPOINT=YOUR_VM_IP:9000

# ========================================
# 應用程式密鑰 (必須設定強密碼)
# ========================================
# 生成方式: openssl rand -base64 32
SECRET_KEY=your-secret-key-replace-this-with-random-string
JWT_SECRET_KEY=your-jwt-secret-key-replace-this-with-random-string

# ========================================
# CORS 配置
# ========================================
# 替換為您的 VM IP 或域名（多個用逗號分隔）
CORS_ORIGINS=http://YOUR_VM_IP,http://your-domain.com

# ========================================
# SMTP 郵件配置
# ========================================
# 使用 Gmail 的應用程式專用密碼
# 申請方式: Google 帳戶 > 安全性 > 兩步驟驗證 > 應用程式密碼
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=usershelter702@gmail.com
SMTP_PASSWORD=wurl vbon uxtw sstn
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=usershelter702@gmail.com

# ========================================
# 前端 API 配置
# ========================================
# 替換為您的 VM IP 或域名
VITE_API_BASE_URL=http://YOUR_VM_IP:5000/api

# ========================================
# 其他配置（可選）
# ========================================
# 生產環境建議設定
# SESSION_COOKIE_SECURE=false  # HTTP 環境設為 false，HTTPS 設為 true
# JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 小時
